        local vp = workspace.CurrentCamera.ViewportSize
        newX = math.clamp(newX, -Main.AbsoluteSize.X + 80, vp.X - 80)
        newY = math.clamp(newY, 0, vp.Y - 40)
        Main.Position = UDim2.new(startPos.X.Scale, newX, startPos.Y.Scale, newY)
    end
end)

