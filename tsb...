        StickyAttack.active=false; StickyAttack.target=nil; StickyAttack.cooldown=STICKY_COOLDOWN
        return true
    end
    return false
end

local function sabrisCheck(name, healthy, backup)
    Sabris.totalChecks = Sabris.totalChecks + 1
    if healthy then Sabris.featureHealth[name] = true; return true end
    Sabris.failedChecks = Sabris.failedChecks + 1
    Sabris.featureHealth[name] = false
    -- Thrash guard: aynı feature için 2s içinde tekrar deneme
    local cd = Sabris.featureCooldown[name] or 0
    if tick() < cd then return false end
    sabrisLog(name, false)
    if backup and backup() then
        Sabris.backupCount = Sabris.backupCount + 1
        Sabris.featureHealth[name] = true
        Sabris.featureCooldown[name] = tick() + 2
        if #Sabris.errorLog > 0 then Sabris.errorLog[#Sabris.errorLog].fixed = true end
        return true
    end
    Sabris.featureCooldown[name] = tick() + 2
    return false
end

local function sabrisRun()
    if Zarzura.suspended then return end
    local c = LocalPlayer.Character; if not c then return end
    local h = c:FindFirstChildOfClass("Humanoid"); if not h then return end

    -- AUTO HEAL: HP < %35 ise stamina/health replenish dene
    if h.Health < h.MaxHealth * 0.35 and tick() - Sabris.lastHealAttempt > 3 then
        Sabris.lastHealAttempt = tick()
        pcall(function()
            for _, n in ipairs({"Health","health","HP","hp"}) do
                local v = c:FindFirstChild(n, true)
                if v and (v:IsA("NumberValue") or v:IsA("IntValue")) then
                    v.Value = v.MaxValue
                end
            end
        end)
    end

    if G.Speed then sabrisCheck("WalkSpeed", math.abs(h.WalkSpeed-Settings.WalkSpeed)<0.5, b1_WS) end
    if G.Jump then sabrisCheck("JumpPower", math.abs(h.JumpPower-Settings.JumpPower)<0.5 and h.UseJumpPower, b2_JP) end
    if G.ESP then
        local missing = 0
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character then
                local hd = p.Character:FindFirstChild("Head")
                local h2 = p.Character:FindFirstChildOfClass("Humanoid")
                if hd and h2 and h2.Health > 0 then
                    local d = espData[p]
                    if not d or not d.bb or not d.bb.Parent then missing = missing + 1 end
                end
            end
        end
        sabrisCheck("ESP", missing == 0, b3_ESP)
    end
    if G.Hitbox then sabrisCheck("Hitbox", currentHitbox ~= nil and currentHitbox.Parent ~= nil, b4_HB) end
    if G.InfStamina then
        local ok = true
        for _, n in ipairs({"Stamina","stamina","StaminaValue","Energy","energy"}) do
            local v = c:FindFirstChild(n, true)
            if v and (v:IsA("NumberValue") or v:IsA("IntValue")) then
                if v.Value < v.MaxValue - 1 then ok = false; break end
            end
        end
        sabrisCheck("InfStamina", ok, b5_ST)
    end
    if G.NoRagdoll or G.FastGetUp then
        local st = h:GetState()
        sabrisCheck("NoRagdoll", st ~= Enum.HumanoidStateType.Ragdoll and st ~= Enum.HumanoidStateType.FallingDown, b6_NR)
    end
    if G.StickyAttack then
        local ok = true
        if StickyAttack.active then
            if not StickyAttack.target or not StickyAttack.target.Character then ok = false
            elseif tick() > StickyAttack.expiry + 5 then ok = false end
        end
        if not ok then sabrisCheck("StickyAttack", false, b7_SR)
        else Sabris.featureHealth["StickyAttack"] = true end
    end
end

local function sabrisUpdate(dt)
    if not Sabris.enabled then return end
    Sabris.lastCheck = Sabris.lastCheck + dt
    pcall(sabrisMeasureCPU)
    -- CPU yüksekse check interval'i uzat
    local interval = Sabris.checkInterval
    if Sabris.cpuLoad > 70 then interval = interval * 1.5 end
    if Sabris.lastCheck < interval then return end
    Sabris.lastCheck = 0
    pcall(sabrisRun)
end

-- ==================== PERF AI (IMPROVED) ====================
local PerfAI = { lastCheck=0, checkInterval=1.5, fpsHistory={}, active=false,
    savedQuality=nil, activationCount=0, minSamples=3, lowThreshold=22, highThreshold=32,
    lowStreak=0, highStreak=0, lowNeeded=2, highNeeded=4 }

local function perfAIEnable()
    if PerfAI.active or Zarzura.suspended then return end
    PerfAI.active = true
    PerfAI.activationCount = PerfAI.activationCount + 1
    if PerfAI.savedQuality == nil then
        PerfAI.savedQuality = settings().Rendering.QualityLevel
    end
    pcall(function()
        settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
        Lighting.GlobalShadows = false; Lighting.ShadowSoftness = 0
        for _, obj in ipairs(Lighting:GetChildren()) do
            if obj:IsA("PostEffect") then obj.Enabled = false end
            if obj:IsA("Atmosphere") then obj.Density=0; obj.Haze=0; obj.Glare=0 end
        end
        Lighting.FogEnd=400; Lighting.FogStart=0
        Lighting.EnvironmentDiffuseScale=0; Lighting.EnvironmentSpecularScale=0
        local t = workspace:FindFirstChildOfClass("Terrain")
        if t then t.WaterWaveSize=0; t.WaterWaveSpeed=0; t.WaterReflectance=0; t.WaterTransparency=1; t.Decoration=false end
        pcall(function() setfpscap(60) end)
    end)
end

local function perfAIDisable()
    if not PerfAI.active then return end
    PerfAI.active = false
    if PerfAI.savedQuality then
        pcall(function() settings().Rendering.QualityLevel = PerfAI.savedQuality end)
    end
    if G.PerfBoost then applyPerfBoost() end
    pcall(function() setfpscap(Settings.FpsCap or 240) end)
end

local function perfAIUpdate(dt)
    if Zarzura.suspended then return end
    PerfAI.lastCheck = PerfAI.lastCheck + dt
    if PerfAI.lastCheck < PerfAI.checkInterval then return end
    PerfAI.lastCheck = 0
    table.insert(PerfAI.fpsHistory, fps)
    if #PerfAI.fpsHistory > 10 then table.remove(PerfAI.fpsHistory, 1) end
    if #PerfAI.fpsHistory < PerfAI.minSamples then return end
    -- Weighted average (recent önemli)
    local sum, wsum = 0, 0
    for i, v in ipairs(PerfAI.fpsHistory) do
        local w = i * i
        sum = sum + v * w
        wsum = wsum + w
    end
    local avg = sum / math.max(1, wsum)

    -- Streak-based decision (thrash engeli)
    if avg <= PerfAI.lowThreshold and avg > 0 then
        PerfAI.lowStreak = PerfAI.lowStreak + 1
        PerfAI.highStreak = 0
        if PerfAI.lowStreak >= PerfAI.lowNeeded and not PerfAI.active then
            perfAIEnable()
            PerfAI.lowStreak = 0
        end
    elseif avg > PerfAI.highThreshold then
        PerfAI.highStreak = PerfAI.highStreak + 1
        PerfAI.lowStreak = 0
        if PerfAI.highStreak >= PerfAI.highNeeded and PerfAI.active then
            perfAIDisable()
            PerfAI.highStreak = 0
        end
    else
        PerfAI.lowStreak = 0
        PerfAI.highStreak = 0
    end
end

