-- ==================== ANA LOOP ====================
RunService.Heartbeat:Connect(function(dt)
    espTick = espTick + dt; dodgeTick = dodgeTick + dt
    ragdollTick = ragdollTick + dt; staminaTick = staminaTick + dt

    zarzuraUpdate(dt)
    sabrisUpdate(dt)
    perfAIUpdate(dt)

    -- HP drop tespiti (DodgeAttack)
    if G.DodgeAttack and not Zarzura.suspended then
        local char = LocalPlayer.Character
        if char then
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 then
                if lastHp > 0 and hum.Health < lastHp - 8 and tick() - lastHpUpdate > 1 then
                    lastHpUpdate = tick()
                    doDodgeBack()
                end
                lastHp = hum.Health
            else
                lastHp = hum and hum.Health or 100
            end
        end
    end

    -- ESP güncelleme
    if G.ESP and not Zarzura.suspended then
        if espTick >= 0.4 then
            espTick = 0
            local active = {}
            for _, p in pairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character then
                    local head = p.Character:FindFirstChild("Head")
                    local hum = p.Character:FindFirstChildOfClass("Humanoid")
                    if head and hum and hum.Health > 0 then
                        active[p] = true
                        local d = espData[p]
                        if d and d.character == p.Character and d.bb and d.bb.Parent then
                            if d.hpLbl and d.hpLbl.Parent then
                                d.hpLbl.Text = math.floor(hum.Health).." / "..math.floor(hum.MaxHealth)
                                d.hpLbl.TextColor3 = getHealthColor(hum)
                            end
                            if d.nameLbl and d.nameLbl.Parent then
                                d.nameLbl.TextColor3 = Settings.C2
                            end
                            if d.hl then d.hl.FillColor = Settings.C2; d.hl.OutlineColor = Settings.C2 end
                        else
                            removeESPForPlayer(p)
                            createESPForPlayer(p, p.Character, head)
                        end
                    end
                end
            end
            for p in pairs(espData) do
                if not active[p] then removeESPForPlayer(p) end
            end
        end
    end

    -- Hitbox
    if G.Hitbox and not Zarzura.suspended then
        if not currentHitbox or not currentHitbox.Parent then createHitbox() end
    end

    -- Sınırsız stamina
    if G.InfStamina and not Zarzura.suspended then
        if staminaTick >= 0.1 then
            staminaTick = 0
            local c = LocalPlayer.Character
            if c then
                for _, n in ipairs({"Stamina","stamina","StaminaValue","Energy","energy"}) do
                    local v = c:FindFirstChild(n, true)
                    if v and (v:IsA("NumberValue") or v:IsA("IntValue")) then
                        pcall(function() v.Value = v.MaxValue end)
                    end
                end
            end
        end
    end

    -- No ragdoll
    if G.NoRagdoll and not Zarzura.suspended then
        if ragdollTick >= 0.2 then
            ragdollTick = 0
            local c = LocalPlayer.Character
            if c then
                local h = c:FindFirstChildOfClass("Humanoid")
                if h then
                    pcall(function()
                        h:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
                        h:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
                        if h.PlatformStand then h.PlatformStand = false end
                    end)
                end
            end
        end
    end

    -- Anti Block (1 stud, hedefin Y pozisyonunda)
    if G.AntiBlock and not Zarzura.suspended then
        antiBlockCooldown = antiBlockCooldown - dt
        if antiBlockCooldown <= 0 then
            local myChar = LocalPlayer.Character
            local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
            if myHrp then
                for _, p in pairs(Players:GetPlayers()) do
                    if p ~= LocalPlayer and p.Character then
                        local tHrp = p.Character:FindFirstChild("HumanoidRootPart")
                        local tHum = p.Character:FindFirstChildOfClass("Humanoid")
                        if tHrp and tHum and tHum.Health > 0 then
                            local delta = myHrp.Position - tHrp.Position
                            local dist = delta.Magnitude
                            if dist < 6 and dist > 0.5 then
                                local look = tHrp.CFrame.LookVector
                                local fd = Vector3.new(delta.X,0,delta.Z)
                                if fd.Magnitude > 0.1 then
                                    local fl = Vector3.new(look.X,0,look.Z).Unit
                                    if fd.Unit:Dot(fl) > 0.6 then
                                        -- distance 1 stud, useTargetY = true (havadaysa arkasında havada)
                                        if doBackTP(p, ANTI_BLOCK_DIST, true, true) then
                                            antiBlockCooldown = ANTI_BLOCK_CD
                                            break
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end

    -- Back TP (2 stud, my Y)
    if G.BackTP and not Zarzura.suspended then
        backTpCooldown = backTpCooldown - dt
        if backTpCooldown <= 0 then
            local myChar = LocalPlayer.Character
            local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
            if myHrp then
                for _, p in pairs(Players:GetPlayers()) do
                    if p ~= LocalPlayer and p.Character then
                        local tHrp = p.Character:FindFirstChild("HumanoidRootPart")
                        local tHum = p.Character:FindFirstChildOfClass("Humanoid")
                        if tHrp and tHum and tHum.Health > 0 then
                            local delta = myHrp.Position - tHrp.Position
                            if delta.Magnitude < STICKY_TRIGGER_DIST + 1.5 then
                                local tVel = tHrp.AssemblyLinearVelocity
                                local fv = Vector3.new(tVel.X,0,tVel.Z)
                                local fd = Vector3.new(delta.X,0,delta.Z)
                                if fv.Magnitude > 15 and fd.Magnitude > 0.1 then
                                    if fv.Unit:Dot(fd.Unit) > 0.5 then
                                        if doBackTP(p, 2, false, false) then
                                            backTpCooldown = BACK_TP_CD
                                            break
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end

    -- Sticky Attack
    if G.StickyAttack and not Zarzura.suspended then
        StickyAttack.cooldown = math.max(0, StickyAttack.cooldown - dt)
        if StickyAttack.active then
            if tick() > StickyAttack.expiry then
                StickyAttack.active = false; StickyAttack.target = nil; StickyAttack.cooldown = STICKY_COOLDOWN
            elseif StickyAttack.target and StickyAttack.target.Character then
                local tHum = StickyAttack.target.Character:FindFirstChildOfClass("Humanoid")
                if not tHum or tHum.Health <= 0 then
                    StickyAttack.active = false; StickyAttack.target = nil; StickyAttack.cooldown = STICKY_COOLDOWN
                else
                    local tHrp = StickyAttack.target.Character:FindFirstChild("HumanoidRootPart")
                    local myChar = LocalPlayer.Character
                    local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
                    if tHrp and myHrp then
                        local dist = (myHrp.Position - tHrp.Position).Magnitude
                        if dist > STICKY_FOLLOW_DIST then
                            local look = tHrp.CFrame.LookVector
                            local back = -Vector3.new(look.X,0,look.Z).Unit
                            local np = tHrp.Position + back * STICKY_FOLLOW_DIST
                            np = Vector3.new(np.X, myHrp.Position.Y, np.Z)
                            if (np - tHrp.Position).Magnitude > 0.1 then
                                pcall(function() myChar:PivotTo(CFrame.lookAt(np, tHrp.Position)) end)
                            end
                        end
                    end
                end
            else
                StickyAttack.active = false; StickyAttack.target = nil
            end
        elseif StickyAttack.cooldown <= 0 then
            local myChar = LocalPlayer.Character
            local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
            if myHrp then
                for _, p in pairs(Players:GetPlayers()) do
                    if p ~= LocalPlayer and p.Character then
                        local tHrp = p.Character:FindFirstChild("HumanoidRootPart")
                        local tHum = p.Character:FindFirstChildOfClass("Humanoid")
                        if tHrp and tHum and tHum.Health > 0 then
                            if (myHrp.Position - tHrp.Position).Magnitude < STICKY_TRIGGER_DIST then
                                StickyAttack.active = true
                                StickyAttack.expiry = tick() + STICKY_DURATION
                                StickyAttack.target = p
                                break
                            end
                        end
                    end
                end
            end
        end
    end
end)

