local function startFloat()
    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end
    if floatBodyPos then return end
    floatSavedGravity = hrp.Gravity
    hrp.Gravity = 0
    local bp = Instance.new("BodyPosition")
    bp.Name = "NOVE_Float"
    bp.Position = hrp.Position
    bp.MaxForce = Vector3.new(math.huge,math.huge,math.huge)
    bp.D = 100; bp.P = 10000
    bp.Parent = hrp
    floatBodyPos = bp
    pcall(function() hum:SetStateEnabled(Enum.HumanoidStateType.Freefall, false) end)
end
local function stopFloat()
    if not floatBodyPos then return end
    floatBodyPos:Destroy(); floatBodyPos = nil
    local char = LocalPlayer.Character
    if char then
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hrp and floatSavedGravity ~= nil then hrp.Gravity = floatSavedGravity end
        if hum then pcall(function() hum:SetStateEnabled(Enum.HumanoidStateType.Freefall, true) end) end
    end
    floatSavedGravity = nil
end

