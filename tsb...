local AllToggles = {}
local function CreateToggle(parent, key, iconType, callback, defaultState)
    local btn = Instance.new("TextButton", parent)
    btn.Size = UDim2.new(1,0,0,46)
    btn.BackgroundColor3 = Color3.fromRGB(16,20,30)
    btn.BackgroundTransparency = 0.15
    btn.Text = ""; btn.AutoButtonColor = false; btn.Active = true
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0,11)
    local st = Instance.new("UIStroke", btn)
    st.Color = Settings.C1; st.Thickness = 1; st.Transparency = 0.85
    createIcon(btn, iconType, 26).Position = UDim2.new(0,12,0.5,-13)
    local tx = Instance.new("TextLabel", btn)
    tx.Size = UDim2.new(1,-120,1,0)
    tx.Position = UDim2.new(0,48,0,0)
    tx.BackgroundTransparency = 1
    tx.TextColor3 = Color3.fromRGB(210,220,235)
    tx.Font = Enum.Font.GothamBold
    tx.TextSize = 12
    tx.TextXAlignment = Enum.TextXAlignment.Left
    tx.Text = L(key); tx.Active = false
    table.insert(LangRefs.plain, {obj=tx, key=key})
    local sw = Instance.new("Frame", btn)
    sw.Size = UDim2.new(0, 42, 0, 24)
    sw.Position = UDim2.new(1,-54,0.5,-12)
    sw.BackgroundColor3 = Color3.fromRGB(26,32,44)
    Instance.new("UICorner", sw).CornerRadius = UDim.new(1,0)
    local swStroke = Instance.new("UIStroke", sw)
    swStroke.Color = Settings.C1; swStroke.Thickness = 1; swStroke.Transparency = 0.9
    local kn = Instance.new("Frame", sw)
    kn.Size = UDim2.new(0, 20, 0, 20)
    kn.Position = UDim2.new(0, 2, 0.5, -10)
    kn.BackgroundColor3 = Color3.fromRGB(180,190,205)
    Instance.new("UICorner", kn).CornerRadius = UDim.new(1,0)

    local state = defaultState or false
    local function upd(animate)
        local ti = animate and TweenInfo.new(0.22, Enum.EasingStyle.Quart, Enum.EasingDirection.Out) or TweenInfo.new(0)
        if state then
            TweenService:Create(btn, ti, {BackgroundColor3=Settings.C1, BackgroundTransparency=0.82}):Play()
            TweenService:Create(st, ti, {Transparency=0.1}):Play()
            TweenService:Create(sw, ti, {BackgroundColor3=Settings.C1}):Play()
            TweenService:Create(swStroke, ti, {Transparency=0.2}):Play()
            TweenService:Create(kn, ti, {Position=UDim2.new(1,-22,0.5,-10), BackgroundColor3=Color3.fromRGB(255,255,255)}):Play()
            tx.TextColor3 = Color3.fromRGB(255,255,255)
        else
            TweenService:Create(btn, ti, {BackgroundColor3=Color3.fromRGB(16,20,30), BackgroundTransparency=0.15}):Play()
            TweenService:Create(st, ti, {Transparency=0.85}):Play()
            TweenService:Create(sw, ti, {BackgroundColor3=Color3.fromRGB(26,32,44)}):Play()
            TweenService:Create(swStroke, ti, {Transparency=0.9}):Play()
            TweenService:Create(kn, ti, {Position=UDim2.new(0,2,0.5,-10), BackgroundColor3=Color3.fromRGB(180,190,205)}):Play()
            tx.TextColor3 = Color3.fromRGB(210,220,235)
        end
    end
    btn.Activated:Connect(function()
        state = not state; upd(true)
        if callback then callback(state) end
    end)
    upd(false)
    table.insert(AllToggles, {btn=btn, updateV=function() upd(true) end, set=function(v) state=v; upd(true) end})
    return btn
end

local function createSlider(parent, key, minV, maxV, currentVal, callback, suffix)
    local row = Instance.new("Frame", parent)
    row.Size = UDim2.new(1,0,0,54)
    row.BackgroundColor3 = Color3.fromRGB(16,20,30)
    row.BackgroundTransparency = 0.15
    Instance.new("UICorner", row).CornerRadius = UDim.new(0,11)
    local rStroke = Instance.new("UIStroke", row)
    rStroke.Color = Settings.C1; rStroke.Thickness = 1; rStroke.Transparency = 0.9
    local sfx = suffix or ""
    local lbl = Instance.new("TextLabel", row)
    lbl.Size = UDim2.new(1,-90,0,20)
    lbl.Position = UDim2.new(0,14,0,6)
    lbl.BackgroundTransparency = 1
    lbl.TextColor3 = Color3.fromRGB(210,220,235)
    lbl.Font = Enum.Font.GothamBold
    lbl.TextSize = 11
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Text = L(key)..": "..(math.floor(currentVal*10)/10)..sfx
    local pill = Instance.new("Frame", row)
    pill.Size = UDim2.new(0, 60, 0, 22)
    pill.Position = UDim2.new(1,-74,0,5)
    pill.BackgroundColor3 = Color3.fromRGB(26,32,44)
    Instance.new("UICorner", pill).CornerRadius = UDim.new(1,0)
    local pStroke = Instance.new("UIStroke", pill)
    pStroke.Color = Settings.C1; pStroke.Thickness = 1; pStroke.Transparency = 0.5
    local pVal = Instance.new("TextLabel", pill)
    pVal.Size = UDim2.fromScale(1,1); pVal.BackgroundTransparency = 1
    pVal.Text = tostring(math.floor(currentVal*10)/10)..sfx
    pVal.TextColor3 = Settings.C1
    pVal.Font = Enum.Font.GothamBold
    pVal.TextSize = 10

    local track = Instance.new("TextButton", row)
    track.Size = UDim2.new(1,-28,0,14)
    track.Position = UDim2.new(0,14,0,32)
    track.BackgroundColor3 = Color3.fromRGB(26,32,44)
    track.Text = ""; track.AutoButtonColor = false
    Instance.new("UICorner", track).CornerRadius = UDim.new(1,0)
    local fill = Instance.new("Frame", track)
    fill.Size = UDim2.new((currentVal-minV)/(maxV-minV),0,1,0)
    fill.BackgroundColor3 = Settings.C1
    fill.BorderSizePixel = 0
    Instance.new("UICorner", fill).CornerRadius = UDim.new(1,0)
    local fillGrad = Instance.new("UIGradient", fill)
    fillGrad.Color = ColorSequence.new(Settings.C1, Settings.C2)
    local handle = Instance.new("Frame", fill)
    handle.Size = UDim2.new(0, 20, 0, 20)
    handle.Position = UDim2.new(1,-10,0.5,-10)
    handle.BackgroundColor3 = Color3.fromRGB(255,255,255)
    handle.ZIndex = 5
    Instance.new("UICorner", handle).CornerRadius = UDim.new(1,0)
    local handleStroke = Instance.new("UIStroke", handle)
    handleStroke.Color = Settings.C1; handleStroke.Thickness = 2

    local function setV(v)
        v = math.clamp(v, minV, maxV)
        currentVal = v
        local r = (v-minV)/(maxV-minV)
        lbl.Text = L(key)..": "..(math.floor(v*10)/10)..sfx
        pVal.Text = tostring(math.floor(v*10)/10)..sfx
        fill.Size = UDim2.new(r,0,1,0)
        if callback then callback(v) end
    end

    local draggingSlider = false
    local function updateFromInput(input)
        local ap, as = track.AbsolutePosition, track.AbsoluteSize
        if as.X <= 0 then return end
        setV(minV + (maxV-minV) * math.clamp((input.Position.X-ap.X)/as.X, 0, 1))
    end
    track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            draggingSlider = true; updateFromInput(input)
            TweenService:Create(handle, TweenInfo.new(0.15), {Size=UDim2.new(0,24,0,24), Position=UDim2.new(1,-12,0.5,-12)}):Play()
            local conn
            conn = input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    draggingSlider = false
                    TweenService:Create(handle, TweenInfo.new(0.2), {Size=UDim2.new(0,20,0,20), Position=UDim2.new(1,-10,0.5,-10)}):Play()
                    if conn then conn:Disconnect() end
                end
            end)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if not draggingSlider then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            updateFromInput(input)
        end
    end)
    table.insert(IconRecolors, function(c1, c2)
        if fill and fill.Parent then
            fill.BackgroundColor3 = c1
            if fillGrad then fillGrad.Color = ColorSequence.new(c1, c2 or c1) end
        end
        if handleStroke and handleStroke.Parent then handleStroke.Color = c1 end
        if pStroke and pStroke.Parent then pStroke.Color = c1 end
        if pVal and pVal.Parent then pVal.TextColor3 = c1 end
    end)
    table.insert(LangRefs.sliders, {lbl=lbl, key=key, suffix=sfx, getVal=function() return currentVal end})
    return {setV=setV}
end

