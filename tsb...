-- useLookDir=true → anti-block (rakip baktığı yönün tersi)
-- useLookDir=false → back-TP (velocity yönüne göre)
-- useTargetY=true → hedefin Y pozisyonu (havadaysa arkasında havada)
local function doBackTP(target, distance, useLookDir, useTargetY)
    distance = distance or 1
    if not target or not target.Character then return false end
    local tHrp = target.Character:FindFirstChild("HumanoidRootPart")
    if not tHrp then return false end
    local tHum = target.Character:FindFirstChildOfClass("Humanoid")
    if not tHum or tHum.Health <= 0 then return false end
    local myChar = LocalPlayer.Character
    if not myChar then return false end
    local myHrp = myChar:FindFirstChild("HumanoidRootPart")
    local myHum = myChar:FindFirstChildOfClass("Humanoid")
    if not myHrp or not myHum or myHum.Health <= 0 then return false end

    local backDir
    if useLookDir then
        local look = tHrp.CFrame.LookVector
        local flat = Vector3.new(look.X, 0, look.Z)
        if flat.Magnitude < 0.01 then return false end
        backDir = -flat.Unit
    else
        local tVel = tHrp.AssemblyLinearVelocity
        if tVel.Magnitude > 5 then
            local fv = Vector3.new(tVel.X, 0, tVel.Z)
            if fv.Magnitude > 0.1 then backDir = -fv.Unit
            else
                local look = tHrp.CFrame.LookVector
                local flat = Vector3.new(look.X, 0, look.Z)
                if flat.Magnitude < 0.01 then return false end
                backDir = -flat.Unit
            end
        else
            local look = tHrp.CFrame.LookVector
            local flat = Vector3.new(look.X, 0, look.Z)
            if flat.Magnitude < 0.01 then return false end
            backDir = -flat.Unit
        end
    end

    local tPos = tHrp.Position + backDir * distance
    local yPos = useTargetY and tHrp.Position.Y or myHrp.Position.Y
    local fPos = Vector3.new(tPos.X, yPos, tPos.Z)

    if (fPos - tHrp.Position).Magnitude < 0.05 then return false end

    local ok, newCF = pcall(function() return CFrame.lookAt(fPos, tHrp.Position) end)
    if not ok or not newCF then return false end

    pcall(function() myHum.PlatformStand = false end)
    pcall(function() myHum.Sit = false end)
    pcall(function()
        myHrp.AssemblyLinearVelocity = Vector3.new()
        myHrp.AssemblyAngularVelocity = Vector3.new()
        myHrp.Velocity = Vector3.new()
        myHrp.RotVelocity = Vector3.new()
    end)
    local moved = pcall(function() myChar:PivotTo(newCF) end)
    if not moved then pcall(function() myHrp.CFrame = newCF end) end
    tpLockCF = newCF; tpLockUntil = tick() + 0.2
    return true
end

