-- Combat detection: yakın düşman / düşük HP
local function zarzuraInCombat()
    local myChar = LocalPlayer.Character
    local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
    local myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")
    if not myHrp or not myHum then return false end
    if myHum.Health < myHum.MaxHealth * 0.35 then return true end
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local tHrp = p.Character:FindFirstChild("HumanoidRootPart")
            local tHum = p.Character:FindFirstChildOfClass("Humanoid")
            if tHrp and tHum and tHum.Health > 0 then
                if (myHrp.Position - tHrp.Position).Magnitude < 25 then return true end
            end
        end
    end
    return false
end

local function zarzuraSuspend()
    if Zarzura.suspended then return end
    Zarzura.suspended = true
    Zarzura.suspendCount = Zarzura.suspendCount + 1
    Zarzura.savedStates = {}
    if G.Float and floatBodyPos then pcall(stopFloat) end
    StickyAttack.active = false; StickyAttack.target = nil; StickyAttack.cooldown = 0
    aimTarget = nil; aimlockExpiry = 0; aimLockStableUntil = 0
    for k, v in pairs(G) do Zarzura.savedStates[k] = v; G[k] = false end
    pcall(cleanAllESP)
    pcall(function()
        settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
        Lighting.GlobalShadows = false
        for _, obj in ipairs(Lighting:GetChildren()) do
            if obj:IsA("PostEffect") then obj.Enabled = false end
        end
    end)
    local myChar = LocalPlayer.Character
    if myChar then
        local hum = myChar:FindFirstChildOfClass("Humanoid")
        if hum then pcall(function() hum.WalkSpeed = 16 end) end
    end
end

local function zarzuraResume()
    if not Zarzura.suspended then return end
    Zarzura.suspended = false
    for k, v in pairs(Zarzura.savedStates) do G[k] = v end
    Zarzura.savedStates = {}
    if G.PerfBoost then applyPerfBoost() end
    if G.ESP then task.spawn(buildAllESPNow) end
    if G.Float then task.spawn(function() task.wait(0.1); pcall(startFloat) end) end
    local myChar = LocalPlayer.Character
    if myChar and G.Speed then
        local hum = myChar:FindFirstChildOfClass("Humanoid")
        if hum then pcall(function() hum.WalkSpeed = Settings.WalkSpeed end) end
    end
end

local function zarzuraUpdate(dt)
    -- Combat'taysa suspend etme
    if zarzuraInCombat() then
        Zarzura.idleTime = 0
        if Zarzura.suspended then zarzuraResume() end
        return
    end
    if zarzuraIsMoving() then
        Zarzura.idleTime = 0
        if Zarzura.suspended then zarzuraResume() end
    else
        Zarzura.idleTime = Zarzura.idleTime + dt
        if Zarzura.idleTime >= Zarzura.idleThreshold and not Zarzura.suspended then
            zarzuraSuspend()
        end
    end
end

-- ==================== SABRIS (IMPROVED) ====================
local Sabris = { enabled=true, lastCheck=0, checkInterval=0.75, cpuHistory={}, cpuLoad=0,
    errorLog={}, backupCount=0, featureHealth={}, totalChecks=0, failedChecks=0,
    featureCooldown={}, lastHealAttempt=0 }

local function sabrisMeasureCPU()
    table.insert(Sabris.cpuHistory, fps)
    if #Sabris.cpuHistory > 8 then table.remove(Sabris.cpuHistory, 1) end
    local sum, wsum = 0, 0
    for i, v in ipairs(Sabris.cpuHistory) do
        local w = i  -- recent weighted more
        sum = sum + v * w
        wsum = wsum + w
    end
    local avg = wsum > 0 and (sum / wsum) or 60
    local variance = 0
    if #Sabris.cpuHistory > 1 then
        for _, x in ipairs(Sabris.cpuHistory) do variance = variance + (x - avg)^2 end
        variance = variance / #Sabris.cpuHistory
    end
    Sabris.cpuLoad = math.clamp(100 - avg + math.sqrt(variance), 0, 100)
end

local function sabrisLog(f, fixed)
    table.insert(Sabris.errorLog, {feature=f, time=tick(), fixed=fixed})
    if #Sabris.errorLog > 25 then table.remove(Sabris.errorLog, 1) end
end

local function b1_WS()
