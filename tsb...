-- LeftShift veya Q ile tetiklenir (mobilde dash butonu yok, HP düşünce)
local dashCooldownUntil = 0
local DASH_COOLDOWN = 1.2
local DASH_POWER = 120

local function doDash(dirOverride)
    local char = LocalPlayer.Character
    if not char then return false end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum or hum.Health <= 0 then return false end
    if tick() < dashCooldownUntil then return false end

    local moveDir = dirOverride
    if not moveDir then
        moveDir = hum.MoveDirection
        if moveDir.Magnitude < 0.1 then
            local cam = workspace.CurrentCamera
            if cam then
                local look = cam.CFrame.LookVector
                moveDir = Vector3.new(look.X, 0, look.Z).Unit
            end
        end
    end
    if moveDir.Magnitude < 0.1 then return false end

    pcall(function()
        hrp.AssemblyLinearVelocity = hrp.AssemblyLinearVelocity + moveDir.Unit * DASH_POWER
    end)
    dashCooldownUntil = tick() + DASH_COOLDOWN
    return true
end

UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if Zarzura.suspended or not G.Dash then return end
    if input.KeyCode == Enum.KeyCode.LeftShift or input.KeyCode == Enum.KeyCode.Q then
        doDash()
    end
end)

