local function validateAimTarget(p)
    if not p or not p.Character then return false end
    local hum = p.Character:FindFirstChildOfClass("Humanoid")
    local head = p.Character:FindFirstChild("Head")
    return hum and hum.Health > 0 and head ~= nil
end

-- Daha akıllı hedef seçimi: crosshair'e yakın olanı tercih eder
local function getAimTarget()
    local myChar = LocalPlayer.Character
    if not myChar then return nil end
    local myHrp = myChar:FindFirstChild("HumanoidRootPart")
    local myHum = myChar:FindFirstChildOfClass("Humanoid")
    if not myHrp or not myHum or myHum.Health <= 0 then return nil end

    -- Lock stability: aynı hedefi kısa süre koru
    if aimTarget and validateAimTarget(aimTarget) and tick() < aimLockStableUntil then
        local tHrp = aimTarget.Character:FindFirstChild("HumanoidRootPart")
        if tHrp and (myHrp.Position - tHrp.Position).Magnitude <= Settings.AimLockDist * 1.5 then
            return aimTarget
        end
        aimTarget = nil; aimLockStableUntil = 0
    elseif aimTarget then
        aimTarget = nil; aimLockStableUntil = 0
    end

    local cam = workspace.CurrentCamera
    local camLook = cam and cam.CFrame.LookVector or Vector3.new(0,0,-1)

    local best, bestScore = nil, -math.huge
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and validateAimTarget(p) then
            local tHrp = p.Character:FindFirstChild("HumanoidRootPart")
            local tHead = p.Character:FindFirstChild("Head")
            if tHrp and tHead then
                local dist = (myHrp.Position - tHrp.Position).Magnitude
                if dist <= Settings.AimLockDist then
                    -- score: yakınlık + kamera hizası
                    local dirToHead = (tHead.Position - cam.CFrame.Position).Unit
                    local dot = dirToHead:Dot(camLook)
                    local score = (1 - dist / Settings.AimLockDist) * 0.5 + (dot + 1) * 0.5
                    if score > bestScore then
                        bestScore = score
                        best = p
                    end
                end
            end
        end
    end
    if best then
        aimTarget = best
        aimLockStableUntil = tick() + 0.6
    end
    return aimTarget
end

-- Predictif aim point
local function getAimPoint(target)
    local char = target.Character
    if not char then return nil end
    local head = char:FindFirstChild("Head")
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not head or not hrp then return nil end
    local myChar = LocalPlayer.Character
    local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
    local myCam = workspace.CurrentCamera

    local dist = 10
    if myHrp then
        dist = (myHrp.Position - head.Position).Magnitude
    end

    local basePos = head.Position
    if dist > 30 and hrp then
        basePos = hrp.Position + Vector3.new(0, 1.2, 0)
    end

    -- velocity lead
    local vel = hrp.AssemblyLinearVelocity
    if vel.Magnitude > 1 then
        local lead = vel * Settings.AIM_PREDICT
        basePos = basePos + lead
    end
    return basePos, myCam
end

local function aimBind()
    if Zarzura.suspended then return end
    local now = tick()
    if not G.Aimlock then
        if aimTarget then aimTarget = nil; aimLockStableUntil = 0 end
        local cam = workspace.CurrentCamera
        if cam and cam.CameraType == Enum.CameraType.Scriptable then
            cam.CameraType = Enum.CameraType.Custom
            local char = LocalPlayer.Character
            if char then
                local hum = char:FindFirstChildOfClass("Humanoid")
                if hum then cam.CameraSubject = hum end
            end
        end
        return
    end
    if now < aimlockCooldownUntil then
        if aimTarget then aimTarget = nil end
        return
    end
    if aimlockExpiry > 0 and now > aimlockExpiry then
        aimlockExpiry = 0; aimlockCooldownUntil = now + AIM_COOLDOWN; aimTarget = nil; return
    end
    local target = getAimTarget()
    if target then
        local aimPos, cam = getAimPoint(target)
        if aimPos and cam then
            if aimlockExpiry == 0 then aimlockExpiry = now + AIM_DURATION end
            local cur = cam.CFrame
            local targetCF = CFrame.lookAt(cur.Position, aimPos)
            cam.CFrame = cur:Lerp(targetCF, Settings.AIM_SMOOTH)
        end
    end
end
pcall(function() RunService:BindToRenderStep("NOVE_AIM", 2000, aimBind) end)

